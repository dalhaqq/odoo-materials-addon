{
  "info": {
    "name": "Materials API",
    "description": "REST API for Materials Management in Odoo 14",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8069", "type": "string" },
    { "key": "db", "value": "odoo", "type": "string" },
    { "key": "username", "value": "admin", "type": "string" },
    { "key": "password", "value": "admin", "type": "string" },
    { "key": "material_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/web/session/authenticate",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"db\": \"{{db}}\",\n    \"login\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Materials",
      "item": [
        {
          "name": "List Materials",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/materials?page=1&limit=20&sort=code&order=asc",
              "host": ["{{base_url}}"],
              "path": ["api", "materials"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "sort", "value": "code" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "List with Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/materials?search=fabric&sort=buy_price&order=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "materials"],
              "query": [
                { "key": "search", "value": "fabric" },
                { "key": "sort", "value": "buy_price" },
                { "key": "order", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Filter by Type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/materials?type=fabric",
              "host": ["{{base_url}}"],
              "path": ["api", "materials"],
              "query": [
                { "key": "type", "value": "fabric" }
              ]
            }
          }
        },
        {
          "name": "Filter by Multiple Types",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/materials?type=fabric,jeans",
              "host": ["{{base_url}}"],
              "path": ["api", "materials"],
              "query": [
                { "key": "type", "value": "fabric,jeans" }
              ]
            }
          }
        },
        {
          "name": "Get Material by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}"]
            }
          }
        },
        {
          "name": "Create Material",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/materials",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"M999\",\n  \"name\": \"Test Material\",\n  \"type\": \"fabric\",\n  \"buy_price\": 200,\n  \"supplier_id\": 1\n}"
            }
          }
        },
        {
          "name": "Update Material",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buy_price\": 300\n}"
            }
          }
        },
        {
          "name": "Delete Material",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}"]
            }
          }
        },
        {
          "name": "Archive Material",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}/archive",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}", "archive"]
            }
          }
        },
        {
          "name": "Unarchive Material",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/materials/{{material_id}}/unarchive",
              "host": ["{{base_url}}"],
              "path": ["api", "materials", "{{material_id}}", "unarchive"]
            }
          }
        }
      ]
    },
    {
      "name": "Utilities",
      "item": [
        {
          "name": "Get Available Types",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/materials/available_types"
          }
        },
        {
          "name": "Get Suppliers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/materials/suppliers"
          }
        }
      ]
    },
    {
      "name": "Error Tests",
      "item": [
        {
          "name": "Get Non-existent Material",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/materials/999999"
          }
        },
        {
          "name": "Create Missing Fields",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/materials",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"M999\"\n}"
            }
          }
        },
        {
          "name": "Create Price Too Low",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/materials",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"M999\",\n  \"name\": \"Cheap Material\",\n  \"type\": \"fabric\",\n  \"buy_price\": 50,\n  \"supplier_id\": 1\n}"
            }
          }
        },
        {
          "name": "Filter Invalid Type",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/materials?type=silk",
              "host": ["{{base_url}}"],
              "path": ["api", "materials"],
              "query": [
                { "key": "type", "value": "silk" }
              ]
            }
          }
        }
      ]
    }
  ]
}
